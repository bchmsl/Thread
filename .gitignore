# Build output and tools. No trailing slash, so the symlinks that keep build
# output out of iCloud Drive are ignored too (adr/ADR-001-build-baseline.md).
build
.gradle
.kotlin
node_modules/

# Local configuration and secrets. Never commit these.
local.properties
.env
.env.*
!.env.example
# Real Firebase project web config (firebase/web-config.example.properties shows the keys).
firebase/web-config.properties
# The Mac app's Google "Desktop app" OAuth client (adr/ADR-020-calendar-meetings-sync.md). The owner fills it.
macCompanion/oauth-desktop.properties

# Firebase CLI and emulator logs
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
database-debug.log
pubsub-debug.log
ui-debug.log

# IDE and OS files
.idea/
*.iml
.vscode/
.claude/settings.local.json
.DS_Store

# Design handoff archives in the root. Their unpacked folders under design/ are tracked.
/*.zip
