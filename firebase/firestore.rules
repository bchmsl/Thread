rules_version = '2';

// Thread talks to Firestore straight from the browser, so these rules are the security boundary
// (adr/ADR-005-auth-and-security-rules.md). Every document belongs to one signed-in account and lives under
// users/{uid}. Only the shapes below can be written; anything not matched is denied. Only the saved versions of a Note
// deleted forever, and the encrypted connections when sync is turned off, can be deleted.
// Document shapes: adr/ADR-004-note-revisions-and-conflicts.md (Notes), adr/ADR-009-workspace-entities-and-sync.md
// (statuses, Topics, preferences), adr/ADR-010-tasks-reminders-and-dates.md (Tasks, Reminders),
// adr/ADR-011-notes-in-the-workspace.md (Note listing fields, Topic links), adr/ADR-012-trash-and-search.md
// (Topics in Trash, Delete forever) and adr/ADR-019-focus-timer.md (Focus timer lengths and history).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Delete forever replaces a Topic, Task, Reminder or Note document with {purgedAt, schemaVersion: 1}, so none of
    // its content stays. Afterwards only another tombstone can be written (two devices deleting the same item): a
    // stale edit from another device cannot bring the item back.
    function isTombstone(data) {
      return data.keys().hasOnly(['purgedAt', 'schemaVersion'])
        && data.keys().hasAll(['purgedAt', 'schemaVersion'])
        && data.schemaVersion == 1
        && data.purgedAt == request.time;
    }

    function notPurged() {
      return resource.data.get('purgedAt', null) == null;
    }

    function noteNotPurged(uid, noteId) {
      let path = /databases/$(database)/documents/users/$(uid)/notes/$(noteId);
      return !exists(path) || get(path).data.get('purgedAt', null) == null;
    }

    // users/{uid}/notes/{noteId}: the Note's current head, its listing (title, preview) and Trash state, written by the
    // note sync, and its filing (inbox, discarded, createdAt), written by the workspace. Writes merge, so a write that
    // does not name deletedAt never moves a Note out of Trash, and neither writer clears the other's fields.
    function validNote(note) {
      return note.keys().hasOnly(['title', 'preview', 'headRevisionId', 'updatedAt', 'schemaVersion', 'deletedAt', 'copiedFrom',
          'inbox', 'discarded', 'createdAt'])
        && note.schemaVersion == 1
        && note.updatedAt == request.time
        && (!('title' in note) || note.title is string)
        && (!('preview' in note) || (note.preview is string && note.preview.size() <= 1000))
        && (!('headRevisionId' in note) || (note.headRevisionId is string && note.headRevisionId.size() > 0))
        && (!('deletedAt' in note) || note.deletedAt == null || note.deletedAt is timestamp)
        && (!('copiedFrom' in note) || validCopiedFrom(note.copiedFrom))
        && (!('inbox' in note) || note.inbox is bool)
        && (!('discarded' in note) || note.discarded is bool)
        && (!('createdAt' in note) || note.createdAt is timestamp);
    }

    // createdAt is set once, by the first workspace write; Notes made before Phase 8 have none.
    function keepsNoteCreatedAt(after, before) {
      return ('createdAt' in before && after.createdAt == before.createdAt)
        || (!('createdAt' in before) && (!('createdAt' in after) || after.createdAt == request.time));
    }

    // users/{uid}/topicNoteLinks/{topicId}_{noteId}: one Note in one Topic. The id is made from the pair, so linking
    // twice writes one document. Unlinking writes linked: false; the Note and the Topic stay.
    function validNoteLink(link, linkId) {
      return link.keys().hasOnly(['topicId', 'noteId', 'linked', 'updatedAt', 'schemaVersion'])
        && link.keys().hasAll(['topicId', 'noteId', 'linked', 'updatedAt', 'schemaVersion'])
        && link.schemaVersion == 1
        && link.updatedAt == request.time
        && link.topicId is string && link.topicId.size() > 0
        && link.noteId is string && link.noteId.size() > 0
        && linkId == link.topicId + '_' + link.noteId
        && link.linked is bool;
    }

    // users/{uid}/externalRefs/{refId}: one Jira ticket or pull request that Topics link to. Ids and the canonical
    // URL only, never a title or other content (adr/ADR-013-jira-in-the-workspace.md, owner-review-queue Q6). The id
    // is made from the fields, so one record linked to several Topics is one document and only the URL can change.
    function validExternalRef(ref, refId) {
      return ref.keys().hasOnly(['provider', 'instance', 'key', 'url', 'updatedAt', 'schemaVersion'])
        && ref.keys().hasAll(['provider', 'instance', 'key', 'url', 'updatedAt', 'schemaVersion'])
        && ref.schemaVersion == 1
        && ref.updatedAt == request.time
        && ref.provider in ['jira', 'github']
        && ref.instance is string && ref.instance.size() > 0 && ref.instance.size() <= 200
        && ref.key is string && ref.key.size() > 0 && ref.key.size() <= 100
        && ref.url is string && ref.url.size() <= 2048 && ref.url.matches('https://.+')
        && refId == ref.provider + '~' + ref.instance.replace('/', '~') + '~' + ref.key;
    }

    // users/{uid}/topicExternalLinks/{topicId}_{refId}: one Topic's link to one external record. Unlinking writes
    // linked: false; the record, the Topic and the external system stay as they are. The optional dismissed is true
    // when the record is not suggested in that Topic (adr/ADR-017-topic-suggestions.md). Documents without it stay
    // valid, and linked and dismissed may both be true: linked wins.
    function validExternalLink(link, linkId) {
      return link.keys().hasOnly(['topicId', 'refId', 'linked', 'dismissed', 'updatedAt', 'schemaVersion'])
        && link.keys().hasAll(['topicId', 'refId', 'linked', 'updatedAt', 'schemaVersion'])
        && link.schemaVersion == 1
        && link.updatedAt == request.time
        && link.topicId is string && link.topicId.size() > 0
        && link.refId is string && link.refId.size() > 0
        && linkId == link.topicId + '_' + link.refId
        && link.linked is bool
        && (!('dismissed' in link) || link.dismissed is bool);
    }

    function validCopiedFrom(source) {
      return source is map
        && source.keys().hasOnly(['noteId', 'revisionId'])
        && source.noteId is string
        && (source.get('revisionId', null) == null || source.revisionId is string);
    }

    // users/{uid}/notes/{noteId}/revisions/{revisionId}: one saved version, never changed after it is written.
    function validRevision(revision) {
      return revision.keys().hasOnly(['parentRevisionId', 'title', 'body', 'schemaVersion', 'deviceId', 'createdAt', 'discardedAt'])
        && revision.keys().hasAll(['parentRevisionId', 'title', 'body', 'schemaVersion', 'deviceId', 'createdAt'])
        && revision.schemaVersion == 1
        && (revision.parentRevisionId == null || (revision.parentRevisionId is string && revision.parentRevisionId.size() > 0))
        && revision.title is string
        && revision.body is string
        && revision.deviceId is string && revision.deviceId.size() > 0
        && revision.createdAt is timestamp
        && (revision.get('discardedAt', null) == null || revision.discardedAt is timestamp);
    }

    // A conflict resolution marks a revision discarded (D41). Two devices that resolve the same way write the same
    // copy of a version again, which changes only createdAt.
    function validRevisionChange(after, before) {
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['discardedAt', 'createdAt'])
        && (!('createdAt' in changed) || after.createdAt == request.time)
        && (!('discardedAt' in changed) || after.get('discardedAt', null) == request.time);
    }

    // users/{uid}/statuses/{statusId}: one workspace status. Deleting a status is a deletedAt write, so Undo works and
    // the document stays. The four category ids are fixed; the name is the person's.
    function validStatus(status) {
      return status.keys().hasOnly(['name', 'category', 'sortOrder', 'deletedAt', 'updatedAt', 'schemaVersion'])
        && status.keys().hasAll(['name', 'category', 'sortOrder', 'updatedAt', 'schemaVersion'])
        && status.schemaVersion == 1
        && status.updatedAt == request.time
        && status.name is string && status.name.size() > 0 && status.name.size() <= 24
        && status.category in ['planned', 'active', 'paused', 'done']
        && status.sortOrder is int
        && (status.get('deletedAt', null) == null || status.deletedAt is timestamp);
    }

    // users/{uid}/topics/{topicId}: one Topic. createdAt is set by the first write and never changes. deletedAt marks a
    // Topic in Trash; its Tasks, Reminders and Note links are not written, so Restore brings them back as they are.
    // info is the Additional information (D52, ADR-018): absent or null until it is saved (Undo writes null), at most
    // 20,100 characters so the two older fields at 10,000 each fit with their labels.
    // color is one of Chrome's nine tab group colors (D72) by its stored id: the five older ids keep their meaning
    // (lavender Purple, mint Green, sky Blue, peach Orange, butter Yellow), and grey, red, pink and cyan are new.
    function validTopic(topic) {
      return topic.keys().hasOnly(['name', 'color', 'statusId', 'goal', 'leftOff', 'nextStep', 'info', 'createdAt', 'updatedAt',
          'deletedAt', 'schemaVersion'])
        && topic.keys().hasAll(['name', 'color', 'statusId', 'goal', 'leftOff', 'nextStep', 'createdAt', 'updatedAt', 'schemaVersion'])
        && topic.schemaVersion == 1
        && topic.updatedAt == request.time
        && topic.name is string && topic.name.size() > 0 && topic.name.size() <= 200
        && topic.color in ['lavender', 'mint', 'sky', 'peach', 'butter', 'grey', 'red', 'pink', 'cyan']
        && topic.statusId is string && topic.statusId.size() > 0
        && validText(topic.goal) && validText(topic.leftOff) && validText(topic.nextStep)
        && (topic.get('info', null) == null || (topic.info is string && topic.info.size() <= 20100))
        && topic.createdAt is timestamp
        && nullOrTimestamp(topic, 'deletedAt');
    }

    function validText(text) {
      return text is string && text.size() <= 10000;
    }

    // users/{uid}/prefs/main: the workspace preferences. keepCompleted and timeZone arrived in Phase 7, and the Focus
    // timer lengths in minutes (focusMin, breakMin) in Phase 14, so a document saved before may lack them.
    function validPrefs(prefs) {
      return prefs.keys().hasOnly(['topicsView', 'captureType', 'keepCompleted', 'timeZone', 'focusMin', 'breakMin', 'updatedAt',
          'schemaVersion'])
        && prefs.keys().hasAll(['topicsView', 'captureType', 'updatedAt', 'schemaVersion'])
        && prefs.schemaVersion == 1
        && prefs.updatedAt == request.time
        && prefs.topicsView in ['list', 'board']
        && prefs.captureType in ['task', 'note', 'topic']
        && (!('keepCompleted' in prefs) || prefs.keepCompleted is bool)
        && (!('timeZone' in prefs) || (prefs.timeZone is string && prefs.timeZone.size() > 0 && prefs.timeZone.size() <= 64))
        && (!('focusMin' in prefs) || (prefs.focusMin is int && prefs.focusMin >= 1 && prefs.focusMin <= 90))
        && (!('breakMin' in prefs) || (prefs.breakMin is int && prefs.breakMin >= 1 && prefs.breakMin <= 30));
    }

    // users/{uid}/focusSessions/f-{runId}: one focus period that ended, or that was stopped after a minute or more.
    // Times are the device's epoch milliseconds, not request.time: a session is written once with fixed values, so the
    // same write again (Retry, or two tabs settling one end) is an update that changes nothing.
    function validFocusSession(session) {
      return session.keys().hasOnly(['startedAt', 'endedAt', 'focusedMs', 'plannedMin', 'outcome', 'targetKind', 'targetId',
          'schemaVersion'])
        && session.keys().hasAll(['startedAt', 'endedAt', 'focusedMs', 'plannedMin', 'outcome', 'targetKind', 'targetId',
          'schemaVersion'])
        && session.schemaVersion == 1
        && session.startedAt is int && session.endedAt is int && session.startedAt <= session.endedAt
        && session.plannedMin is int && session.plannedMin >= 1 && session.plannedMin <= 90
        && session.focusedMs is int && session.focusedMs >= 60000 && session.focusedMs <= session.plannedMin * 60000
        && session.outcome in ['completed', 'stopped']
        && ((session.targetKind == null && session.targetId == null)
          || (session.targetKind in ['task', 'topic']
            && session.targetId is string && session.targetId.size() > 0 && session.targetId.size() <= 128));
    }

    // A calendar day, YYYY-MM-DD, and a deadline, a day with an optional HH:MM. Never instants, so they never shift.
    function validDay(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    function validDeadline(value) {
      return value is string && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2})?');
    }

    function nullOrTimestamp(map, key) {
      return map.get(key, null) == null || map[key] is timestamp;
    }

    // users/{uid}/tasks/{taskId}: one personal Task. Trash is a deletedAt write; an undone capture is also discarded.
    function validTask(task) {
      return task.keys().hasOnly(['title', 'topicId', 'done', 'completedOn', 'plannedDay', 'deadline', 'inbox', 'createdAt',
          'updatedAt', 'deletedAt', 'discarded', 'schemaVersion'])
        && task.keys().hasAll(['title', 'topicId', 'done', 'completedOn', 'plannedDay', 'deadline', 'inbox', 'createdAt',
          'updatedAt', 'schemaVersion'])
        && task.schemaVersion == 1
        && task.updatedAt == request.time
        && task.title is string && task.title.size() > 0 && task.title.size() <= 500
        && (task.topicId == null || (task.topicId is string && task.topicId.size() > 0))
        && task.done is bool
        && task.inbox is bool
        && (task.completedOn == null || validDay(task.completedOn))
        && (task.plannedDay == null || validDay(task.plannedDay))
        && (task.deadline == null || validDeadline(task.deadline))
        && task.createdAt is timestamp
        && nullOrTimestamp(task, 'deletedAt')
        && (!('discarded' in task) || task.discarded is bool);
    }

    // users/{uid}/reminders/{reminderId}: one in-app reminder at a wall-clock time in its time zone.
    function validReminder(reminder) {
      return reminder.keys().hasOnly(['at', 'zone', 'text', 'targetKind', 'targetId', 'dismissedAt', 'createdAt', 'updatedAt',
          'deletedAt', 'schemaVersion'])
        && reminder.keys().hasAll(['at', 'zone', 'text', 'targetKind', 'targetId', 'createdAt', 'updatedAt', 'schemaVersion'])
        && reminder.schemaVersion == 1
        && reminder.updatedAt == request.time
        && reminder.at is string && reminder.at.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}')
        && reminder.zone is string && reminder.zone.size() > 0 && reminder.zone.size() <= 64
        && reminder.text is string && reminder.text.size() > 0 && reminder.text.size() <= 500
        && reminder.targetKind in ['task', 'note', 'topic']
        && reminder.targetId is string && reminder.targetId.size() > 0
        && reminder.createdAt is timestamp
        && nullOrTimestamp(reminder, 'dismissedAt')
        && nullOrTimestamp(reminder, 'deletedAt');
    }

    match /users/{uid}/notes/{noteId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && ((validNote(request.resource.data)
          && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time))
          || isTombstone(request.resource.data));
      allow update: if signedInAs(uid)
        && (isTombstone(request.resource.data)
          || (notPurged() && validNote(request.resource.data) && keepsNoteCreatedAt(request.resource.data, resource.data)));

      // A Note deleted forever loses its versions too. Nothing is written to the versions of such a Note.
      match /revisions/{revisionId} {
        allow read: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && validRevision(request.resource.data)
          && request.resource.data.createdAt == request.time
          && !('discardedAt' in request.resource.data)
          && noteNotPurged(uid, noteId);
        allow update: if signedInAs(uid)
          && validRevision(request.resource.data)
          && validRevisionChange(request.resource.data, resource.data)
          && noteNotPurged(uid, noteId);
        allow delete: if signedInAs(uid)
          && get(/databases/$(database)/documents/users/$(uid)/notes/$(noteId)).data.get('purgedAt', null) != null;
      }
    }

    match /users/{uid}/topicNoteLinks/{linkId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validNoteLink(request.resource.data, linkId);
    }

    match /users/{uid}/externalRefs/{refId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validExternalRef(request.resource.data, refId);
    }

    match /users/{uid}/topicExternalLinks/{linkId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validExternalLink(request.resource.data, linkId);
    }

    match /users/{uid}/statuses/{statusId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validStatus(request.resource.data);
    }

    match /users/{uid}/topics/{topicId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && ((validTopic(request.resource.data) && request.resource.data.createdAt == request.time)
          || isTombstone(request.resource.data));
      allow update: if signedInAs(uid)
        && (isTombstone(request.resource.data)
          || (notPurged() && validTopic(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt));
    }

    match /users/{uid}/tasks/{taskId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && ((validTask(request.resource.data) && request.resource.data.createdAt == request.time)
          || isTombstone(request.resource.data));
      allow update: if signedInAs(uid)
        && (isTombstone(request.resource.data)
          || (notPurged() && validTask(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt));
    }

    match /users/{uid}/reminders/{reminderId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && ((validReminder(request.resource.data) && request.resource.data.createdAt == request.time)
          || isTombstone(request.resource.data));
      allow update: if signedInAs(uid)
        && (isTombstone(request.resource.data)
          || (notPurged() && validReminder(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt));
    }

    // The history is never edited or deleted in this phase. An update must change nothing (see validFocusSession).
    match /users/{uid}/focusSessions/{sessionId} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && sessionId.matches('f-[A-Za-z0-9_-]{1,64}')
        && validFocusSession(request.resource.data);
      allow update: if signedInAs(uid) && request.resource.data.diff(resource.data).affectedKeys().size() == 0;
    }

    match /users/{uid}/prefs/{prefsId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && prefsId == 'main' && validPrefs(request.resource.data);
    }

    // users/{uid}/vault/connections: the account's Jira and GitHub connections, encrypted in the browser with a key made
    // from the person's passphrase (adr/ADR-016-encrypted-connection-sync.md). Only base64 of the salt, the IV and the
    // AES-GCM ciphertext, and how to derive the key again; never a token, e-mail, site or passphrase in plain text.
    // Turning sync off deletes it.
    function validVault(vault) {
      return vault.keys().hasOnly(['schemaVersion', 'kdf', 'iterations', 'salt', 'iv', 'ciphertext', 'updatedAt'])
        && vault.keys().hasAll(['schemaVersion', 'kdf', 'iterations', 'salt', 'iv', 'ciphertext', 'updatedAt'])
        && vault.schemaVersion == 1
        && vault.kdf == 'PBKDF2-SHA-256'
        && vault.iterations is int && vault.iterations >= 600000 && vault.iterations <= 10000000
        && vault.salt is string && vault.salt.matches('[A-Za-z0-9+/]{22}==')
        && vault.iv is string && vault.iv.matches('[A-Za-z0-9+/]{16}')
        && vault.ciphertext is string && vault.ciphertext.size() >= 24 && vault.ciphertext.size() <= 8192
        && vault.ciphertext.matches('[A-Za-z0-9+/]+={0,2}')
        && vault.updatedAt == request.time;
    }

    match /users/{uid}/vault/{vaultId} {
      allow read, delete: if signedInAs(uid) && vaultId == 'connections';
      allow create, update: if signedInAs(uid) && vaultId == 'connections' && validVault(request.resource.data);
    }
  }
}
